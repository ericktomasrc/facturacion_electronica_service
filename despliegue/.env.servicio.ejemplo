# =============================================================================
# .env.servicio — el servicio de facturación (API y Worker), en producción.
# Copia a .env.servicio EN EL SERVIDOR y rellénalo. Nunca entra en git.
#
# La entrega comparó los NOMBRES (nunca los valores) de tu .env de desarrollo
# con esta plantilla: si alguno falta aquí, lo dijo al terminar.
# =============================================================================

# --- Base de datos (dentro de la red de Docker) ---------------------------------
POSTGRES_HOST=db-facturacion
POSTGRES_PORT=5432
POSTGRES_DB=facturacion
# Nuevas para producción (no las de la 001 ni las de desarrollo). migrar.sh las pone.
FACTURACION_APP_PASSWORD=
FACTURACION_OPERADOR_PASSWORD=
# El rol de la ruta de alta (migración 034). Obligatoria en producción.
FACTURACION_ALTA_PASSWORD=

# --- La llave maestra ----------------------------------------------------------
# NUEVA para producción, generada ANTES de subir el primer certificado:
#     openssl rand -base64 32
# Guárdala en el gestor de contraseñas. Si se pierde, se pierden los
# certificados de todos los clientes. NO va en los respaldos (a propósito).
FACTURACION_LLAVE_MAESTRA=

# --- Almacén (MinIO de este compose; para R2, su endpoint y sus claves) -------
Almacen__Tipo=s3
Almacen__Endpoint=http://almacen:9000
Almacen__Bucket=comprobantes
Almacen__Region=us-east-1
# Con el MinIO de este compose: los mismos MINIO_ROOT_USER y MINIO_ROOT_PASSWORD
# del .env (o un usuario propio creado con «mc admin user add»). Vacíos, la API no arranca.
ALMACEN_USUARIO=
ALMACEN_CLAVE=

# --- Correo (un proveedor que firme DKIM con reyban.pe; ver §3.1 y §9) -------
MAIL_HOST=
MAIL_PORT=587
MAIL_USUARIO=
MAIL_CLAVE=
MAIL_DESDE=comprobantes@reyban.pe
MAIL_NOMBRE=Facturación electrónica

# --- El primer administrador del panel del servicio -------------------------------
# Sin ellas se crea admin@localhost y su contraseña provisional queda en los logs.
# Quita ADMIN_CONTRASENA del archivo después de entrar y cambiarla.
ADMIN_CORREO=
ADMIN_CONTRASENA=

# --- Direcciones públicas ---------------------------------------------------------
PANEL_URL=https://api.reyban.pe
# Sin esta, los enlaces de los correos al receptor apuntarían a PANEL_URL/portal.
PORTAL_URL=https://comprobantes.reyban.pe

# --- Comportamiento -----------------------------------------------------------------
# true = un XML que no cumple su XSD NO se envía. Empezar en false y mirar
# «Esquemas XSD» unas semanas.
FACTURACION_XSD_BLOQUEA=false
# La prueba de cada madrugada contra SUNAT beta. Se llama a sí misma por dentro.
PRUEBA_MADRUGADA_ACTIVA=true
PRUEBA_MADRUGADA_HORA=03:00
PRUEBA_MADRUGADA_URL=http://localhost:8080

# NO van en producción: FACTURACION_WEBHOOKS_LOCALES, FACTURACION_TLS_INSEGURO.