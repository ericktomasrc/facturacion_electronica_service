# =============================================================================
# .env.servicio — el servicio de facturación (API y Worker), SERVIDOR DE
# APLICACIÓN de QA (opción B′). Copia a .env.servicio EN ESE SERVIDOR:
#     cp .env.servicio.qa.ejemplo .env.servicio && chmod 600 .env.servicio && nano .env.servicio
# Nunca entra en git. Todo NUEVO, distinto de desarrollo.
# =============================================================================

# --- Base de datos: en el OTRO servidor, por la red privada ---------------------
POSTGRES_HOST=            # la IP PRIVADA del servidor de base (la IP_PRIVADA de su .env.base)
POSTGRES_PORT=5432
POSTGRES_DB=facturacion
# Las mismas que en el .env.base del servidor de base (migrar.sh las pone allí).
FACTURACION_APP_PASSWORD=
FACTURACION_OPERADOR_PASSWORD=
FACTURACION_ALTA_PASSWORD=

# --- La llave maestra del servicio ---------------------------------------------
# NUEVA para QA, generada ANTES de subir el primer certificado:
#     openssl rand -base64 32
# Guárdala en el gestor de contraseñas. Si se pierde, se pierden los
# certificados de todos los clientes. NO va en los respaldos (a propósito).
FACTURACION_LLAVE_MAESTRA=

# --- Almacén: Cloudflare R2 ------------------------------------------------------
# En Cloudflare: R2 > crear el bucket (p. ej. reyban-comprobantes-qa) y un
# token de API de R2 con permiso de lectura y escritura SOLO en ese bucket.
Almacen__Tipo=s3
Almacen__Endpoint=https://<ID-DE-CUENTA>.r2.cloudflarestorage.com
Almacen__Bucket=reyban-comprobantes-qa
Almacen__Region=auto
ALMACEN_USUARIO=          # «Access Key ID» del token de R2
ALMACEN_CLAVE=            # «Secret Access Key» del token de R2

# --- Correo (un proveedor que firme DKIM con tu dominio) -------------------------
MAIL_HOST=
MAIL_PORT=587
MAIL_USUARIO=
MAIL_CLAVE=
MAIL_DESDE=comprobantes@reyban.pe
MAIL_NOMBRE=Facturación electrónica

# --- El primer administrador del panel del servicio -------------------------------
# Quita ADMIN_CONTRASENA del archivo después de entrar y cambiarla.
ADMIN_CORREO=
ADMIN_CONTRASENA=

# --- Direcciones públicas ---------------------------------------------------------
PANEL_URL=https://api.qa.reyban.pe
PORTAL_URL=https://comprobantes.qa.reyban.pe

# --- Comportamiento -----------------------------------------------------------------
FACTURACION_XSD_BLOQUEA=false
PRUEBA_MADRUGADA_ACTIVA=true
PRUEBA_MADRUGADA_HORA=03:00
PRUEBA_MADRUGADA_URL=http://localhost:8080

# NO van fuera de desarrollo: FACTURACION_WEBHOOKS_LOCALES, FACTURACION_TLS_INSEGURO.