# =============================================================================
# .env.plataforma — la plataforma (API + front), en producción.
# Copia a .env.plataforma EN EL SERVIDOR y rellénalo. Nunca entra en git.
#
# La entrega comparó los NOMBRES (nunca los valores) de tu .env de desarrollo
# con esta plantilla: si alguno falta aquí, lo dijo al terminar.
# =============================================================================

# La contraseña de plataforma_app va DENTRO de la cadena; migrar.sh la lee de
# aquí y se la pone al rol. Nueva para producción.
PLATAFORMA_CADENA_CONEXION=Host=db-plataforma;Port=5432;Database=plataforma;Username=plataforma_app;Password=

# La llave maestra de la plataforma (claves fac_ y segundos factores). NUEVA
# para producción (openssl rand -base64 32) y guardada en el gestor de
# contraseñas. Sin ella la plataforma no arranca.
PLATAFORMA_LLAVE_MAESTRA=

# El primer super administrador. Quita ADMIN_CONTRASENA después de entrar y cambiarla.
ADMIN_CORREO=
ADMIN_CONTRASENA=

# Direcciones
PLATAFORMA_URL_PUBLICA=https://app.reyban.pe
PLATAFORMA_URL_API=https://app.reyban.pe
# El servicio, por su dirección pública (con TLS).
FACTURACION_BASE_URL=https://api.reyban.pe
# Una clave de alta NUEVA, emitida en el panel del servicio de producción.
FACTURACION_CLAVE_ALTA=

# Correo
MAIL_ENABLED=true
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Reyban

# Consultas de RUC, DNI y tipo de cambio (Decolecta, decolecta.com). Sin token,
# los datos del cliente se escriben a mano.
DECOLECTA_TOKEN=
DECOLECTA_LIMITE_MES=1000
DECOLECTA_DNI=true
DECOLECTA_CONTACTO_WHATSAPP=+51 984001136
DECOLECTA_CONTACTO_CORREO=

# NO va en producción: FACTURACION_TLS_INSEGURO.