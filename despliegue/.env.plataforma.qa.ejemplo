# =============================================================================
# .env.plataforma — la plataforma (API + front), SERVIDOR DE APLICACIÓN de QA
# (opción B′). Copia a .env.plataforma EN ESE SERVIDOR:
#     cp .env.plataforma.qa.ejemplo .env.plataforma && chmod 600 .env.plataforma && nano .env.plataforma
# Nunca entra en git. Todo NUEVO, distinto de desarrollo.
# =============================================================================

# La base, en el OTRO servidor por la red privada: Host = IP privada del
# servidor de base, puerto 5433. La Password = PLATAFORMA_APP_PASSWORD de su
# .env.base (migrar.sh se la pone al rol).
PLATAFORMA_CADENA_CONEXION=Host=<IP-PRIVADA-BASE>;Port=5433;Database=plataforma;Username=plataforma_app;Password=

# La llave maestra de la plataforma (claves fac_ y segundos factores). NUEVA
# para QA (openssl rand -base64 32) y guardada en el gestor de contraseñas.
PLATAFORMA_LLAVE_MAESTRA=

# El primer super administrador. Al entrar la primera vez pide contraseña nueva
# y segundo factor. Después, borra PLATAFORMA_ADMIN_CLAVE de este archivo.
PLATAFORMA_ADMIN_CORREO=
PLATAFORMA_ADMIN_CLAVE=

# Direcciones: la API sirve el front, así que las dos son la misma.
PLATAFORMA_URL_PUBLICA=https://app.qa.reyban.pe
PLATAFORMA_URL_API=https://app.qa.reyban.pe

# El servicio, POR DENTRO (misma máquina, red de Docker): no sale a internet.
FACTURACION_BASE_URL=http://facturacion-api:8080
# Una clave de alta NUEVA, emitida en el panel del servicio de QA.
FACTURACION_CLAVE_ALTA=

# SUNAT: en QA NO se pone. Así el super administrador tiene el interruptor
# «Conexión con SUNAT» (beta/real) y pasa a real las empresas marcadas, una a
# una. Solo en PRODUCCIÓN: PLATAFORMA_SUNAT=real (fijo, sin interruptor).
#PLATAFORMA_SUNAT=real

# Correo
MAIL_ENABLED=true
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Reyban

# Decolecta (RUC, DNI, tipo de cambio). Un token NUEVO, no el de desarrollo.
DECOLECTA_TOKEN=
DECOLECTA_LIMITE_MES=100
DECOLECTA_CONTACTO_WHATSAPP=

# Captcha del registro (Cloudflare Turnstile). Claves reales del dominio de QA.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# NO va fuera de desarrollo: FACTURACION_TLS_INSEGURO.