# =============================================================================
# .env.aplicacion — lo que lee docker compose en el SERVIDOR DE APLICACIÓN.
# Copia a .env.aplicacion EN ESE SERVIDOR y rellénalo. Nunca entra en git.
# =============================================================================

# Los tres dominios de QA (sus registros A ya tienen que apuntar a este servidor).
DOMINIO_SERVICIO=api.qa.reyban.pe
DOMINIO_PORTAL=comprobantes.qa.reyban.pe
DOMINIO_PLATAFORMA=app.qa.reyban.pe
# A este correo escribe Let's Encrypt si un certificado no se puede renovar.
CORREO_TLS=

# PROTECCIÓN DE QA: las IP que entran sin contraseña, separadas por espacio,
# con su /32. Tu IP pública: https://ifconfig.me (desde tu casa/oficina).
# Desde cualquier otra IP, Caddy pide el usuario y la contraseña de
# qa_usuarios.caddy (ver GUIA-QA.md).
QA_IPS_PERMITIDAS=127.0.0.1/32

# Dónde está la carpeta reyban_plataforma, relativo a esta carpeta (para
# construir la imagen aquí). Con la misma estructura que en tu PC, no tocar.
#RUTA_PLATAFORMA=../../../reyban_plataforma