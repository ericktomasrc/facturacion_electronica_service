# =============================================================================
# .env.base — SERVIDOR DE BASE DE DATOS (QA, opción B′).
# Copia este archivo a .env.base EN ESE SERVIDOR y rellénalo:
#     cp .env.base.ejemplo .env.base && chmod 600 .env.base && nano .env.base
# Nunca entra en git ni sale del servidor. Todo NUEVO, distinto de desarrollo.
# Contraseñas largas y al azar, una distinta para cada cosa:
#     openssl rand -base64 32 | tr -d '/+=' | cut -c1-32
# =============================================================================

# La IP PRIVADA de ESTE servidor (la de la red privada del proveedor, p. ej.
# 10.x.x.x). Las bases escuchan solo ahí.
IP_PRIVADA=

# Los dueños de cada base (los que corren las migraciones). Solo viven aquí.
POSTGRES_PASSWORD_FACTURACION=
POSTGRES_PASSWORD_PLATAFORMA=

# Las contraseñas de los roles con que se conectan las aplicaciones. migrar.sh
# se las pone a la base. TIENEN QUE SER LAS MISMAS que en el servidor de
# aplicación (.env.servicio y la Password= de .env.plataforma).
FACTURACION_APP_PASSWORD=
FACTURACION_OPERADOR_PASSWORD=
FACTURACION_ALTA_PASSWORD=
PLATAFORMA_APP_PASSWORD=

# Dónde están las migraciones de la plataforma, relativo a esta carpeta. Con la
# misma estructura de carpetas que en tu PC no hace falta tocarlo.
#RUTA_PLATAFORMA=../../../reyban_plataforma

# Copia del respaldo fuera del servidor (rclone configurado con R2), p. ej.
# r2:reyban-respaldos-qa
RESPALDO_RCLONE_DESTINO=
# Copia de los archivos de R2 (XML, CDR, PDF) a otro bucket, sin borrar nunca
# nada (rclone copy). Origen y destino, p. ej.:
#ALMACEN_RCLONE_ORIGEN=r2:reyban-comprobantes-qa
#ALMACEN_RCLONE_DESTINO=r2:reyban-respaldos-qa/almacen