# =============================================================================
# CADDY DE QA (opción B′) — TLS automático, proxy y la protección de QA.
#
#   {$DOMINIO_SERVICIO}    la API del servicio y su panel        (api.reyban.pe)
#   {$DOMINIO_PORTAL}      el portal del receptor                (comprobantes.reyban.pe)
#   {$DOMINIO_PLATAFORMA}  la plataforma: front + /api           (app.reyban.pe)
#
# Comprobar sin arrancar:
#   docker compose -f compose.aplicacion.yml --env-file .env.aplicacion run --rm caddy caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile
# =============================================================================

{
	email {$CORREO_TLS}
}

(comun) {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}
	# Los .pfx, los logos y el paquete de esquemas XSD (hasta 25 MB) caben.
	# 042: el padrón de SUNAT que se sube a mano pesa cientos de MB: solo esa
	# ruta admite hasta 2 GB (y exige sesión con permiso en la plataforma).
	@subida_padron path /api/admin/consultas-sunat/padron/subir
	@no_subida_padron not path /api/admin/consultas-sunat/padron/subir
	request_body @no_subida_padron {
		max_size 30MB
	}
	request_body @subida_padron {
		max_size 2GB
	}
}

# -----------------------------------------------------------------------------
# PROTECCIÓN DE QA (038). La plataforma y el panel del servicio solo se abren:
#   · desde las IP de QA_IPS_PERMITIDAS (tu casa, tu oficina), o
#   · con el usuario y la contraseña de qa_usuarios.caddy (para cuando estás
#     fuera o tu IP cambió).
# Quedan abiertos, porque los usa otra máquina y ya llevan su propia llave:
#   · /health
#   · /api/webhooks/facturacion/*   los avisos del servicio a la plataforma
#                                   (firmados con su secreto)
#   · /v1/* y /alta/*               la API del servicio (exige su clave fac_/alt_)
# El portal del receptor NO se protege: lo abren los clientes de tus clientes.
#
# PARA PRODUCCIÓN: se quitan las dos líneas «import protegido_qa».
# -----------------------------------------------------------------------------
(protegido_qa) {
	@fuera_de_qa {
		not remote_ip {$QA_IPS_PERMITIDAS:127.0.0.1/32}
		not path /health /api/webhooks/facturacion/* /v1/* /alta/*
	}
	basic_auth @fuera_de_qa {
		import /etc/caddy/qa_usuarios.caddy
	}
}

{$DOMINIO_SERVICIO} {
	import comun
	import protegido_qa
	header X-Frame-Options "DENY"
	reverse_proxy facturacion-api:8080
}

# EL PORTAL: el receptor ve comprobantes.reyban.pe/{empresa}/..., y el
# servicio lo sirve bajo /portal. Se REESCRIBE (no se redirige) y se antepone
# /portal a TODO: por este dominio no se llega ni a /v1 ni a /admin.
{$DOMINIO_PORTAL} {
	import comun
	header X-Frame-Options "DENY"
	rewrite * /portal{uri}
	reverse_proxy facturacion-api:8080
}

{$DOMINIO_PLATAFORMA} {
	import comun
	import protegido_qa
	header X-Frame-Options "DENY"
	reverse_proxy plataforma:8080
}