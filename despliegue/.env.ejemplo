# =============================================================================
# .env — lo que lee docker compose (junto a docker-compose.produccion.yml).
# Copia este archivo a .env EN EL SERVIDOR y rellénalo. Nunca entra en git.
# Contraseñas: largas y al azar, una distinta para cada cosa:  openssl rand -base64 32
# =============================================================================

# Los tres dominios (sus registros A ya tienen que apuntar al servidor).
DOMINIO_SERVICIO=api.reyban.pe
DOMINIO_PORTAL=comprobantes.reyban.pe
DOMINIO_PLATAFORMA=app.reyban.pe
# A este correo escribe Let's Encrypt si un certificado no se puede renovar.
CORREO_TLS=

# Las contraseñas de los dueños de cada base (los que corren las migraciones).
POSTGRES_PASSWORD_FACTURACION=
POSTGRES_PASSWORD_PLATAFORMA=

# El almacén (MinIO). Si se usa Cloudflare R2, se quita el servicio «almacen».
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
# Mejor una versión fija que ya probaste, en vez de latest:
#IMAGEN_MINIO=quay.io/minio/minio:RELEASE.<fecha>

# Dónde está la carpeta reyban_plataforma, relativo a esta carpeta. Con la
# misma estructura que en tu equipo no hace falta tocarlo.
#RUTA_PLATAFORMA=../../../reyban_plataforma

# Copia del respaldo fuera del servidor (rclone ya configurado), p. ej. r2:reyban-respaldos
RESPALDO_RCLONE_DESTINO=