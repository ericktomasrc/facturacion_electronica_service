# ===========================================================================
# SECRETOS DEL SERVICIO DE FACTURACIÓN
#
# ESTE ARCHIVO NO SE VERSIONA. Compruébalo antes de seguir:
#
#     git check-ignore -v .env
#
# Si no devuelve nada, falta añadirlo al .gitignore y NO debes hacer commit.
#
# Los valores de abajo se generaron al azar. Son válidos tal cual para
# desarrollo. Para producción, genera otros en la máquina donde vayan a
# usarse y no los copies de ningún chat, correo ni documento.
# ===========================================================================


# --- Base de datos ---------------------------------------------------------
#
# El servidor y el puerto no son secretos, pero se ponen aquí para que todo
# lo de la conexión esté junto.

POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=facturacion

# Dueño del esquema. Solo lo usan las migraciones.
POSTGRES_PASSWORD=0X3FvqfY1lOREIzUAdUtJZZXp1-_

# La aplicación. Sujeto a Row Level Security: solo ve la empresa declarada.
FACTURACION_APP_PASSWORD=.9EK7vWesBxJxhn3SjV3tlOU02Tr

# El operador. Ve todas las empresas: lo usan el panel y los workers para
# repartir trabajo.
FACTURACION_OPERADOR_PASSWORD=xlXzUteZLXh_mwaZjGwhMJ880U5.


# --- Llave maestra de cifrado ----------------------------------------------
#
# Protege los certificados digitales y las claves SOL de tus clientes.
#
# ESTE VALOR ES EL QUE YA VENÍAS USANDO. No lo cambies: si lo haces, los
# certificados ya guardados dejan de poder descifrarse y hay que volver a
# cargarlos uno por uno.
#
# SI SE PIERDE, esos datos quedan irrecuperables. No hay puerta trasera, y de
# eso se trata. Guárdala AHORA en un gestor de contraseñas.

FACTURACION_LLAVE_MAESTRA=1+QZmOPbcU8iTb4QufsvtBaoorHh2uSwSdTtYg68VIw=


# --- Almacén de archivos (MinIO) -------------------------------------------
#
# Las dos primeras las usa el contenedor al arrancar; las dos siguientes,
# la API y el worker para conectarse. Deben coincidir.

MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=JV6ma2DmyFGD76Wzc15akqE_PfsJ

ALMACEN_USUARIO=minioadmin
ALMACEN_CLAVE=JV6ma2DmyFGD76Wzc15akqE_PfsJ


# --- Panel de operación ----------------------------------------------------
#
# Da acceso a los datos de TODAS las empresas y a sus certificados.
#
# Es provisional: una clave compartida no permite saber quién hizo qué ni
# quitarle el acceso a una persona concreta. Antes de que alguien más use el
# panel hay que reemplazarla por usuarios con contraseña y roles.


# --- Correo ----------------------------------------------------------------
#
# Para la recuperación de contraseña y los avisos.
#
# CON GMAIL hace falta una CONTRASEÑA DE APLICACIÓN, no la de la cuenta:
# entra en la configuración de tu cuenta de Google, busca "Contraseñas de
# aplicaciones" y genera una. Requiere tener activada la verificación en dos
# pasos en esa cuenta.
#
# Si dejas MAIL_HOST vacío, el sistema funciona igual pero sin enviar correos,
# y lo avisa en el log al arrancar.

MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USUARIO=reybandev@gmail.com
MAIL_CLAVE=odxzsqqewtnfwhkk
MAIL_DESDE=reybandev@gmail.com
MAIL_NOMBRE=Facturación electrónica

PANEL_URL=https://localhost:7295

