{
  "Almacen": {
    "Tipo": "s3",
    "Endpoint": "http://localhost:9000",
    "Bucket": "comprobantes",
    "Region": "us-east-1"
  },
  "Worker": {
    "TamanoLote": 10,
    "Concurrencia": 8,
    "EsperaSegundos": 5
  },
  "Resumenes": {
    "IntervaloSegundos": 60
  },
  "Webhooks": {
    "IntervaloSegundos": 10
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  }
}